     std::vector<int> beat_counts; // Beat numbers for each beat (1 = downbeat, 2,3,4... = other beats)
 };
 
+// Both postprocessors decoded from ONE model pass over the audio.
+//
+// The DBN and the minimal peak-picker read the same logits, so running the network twice
+// to see both grids would be pure waste -- and seeing both is the point. The DBN's
+// 55-215 BPM state space lets it change pulse level partway through a track, which is a
+// legitimate decoding but produces a grid that is internally inconsistent; the minimal
+// grid cannot do that, because it has no tempo model at all. Which one is steadier is a
+// per-file question with a measurable answer, so the caller gets both and decides.
+struct BeatResultPair {
+    BeatResult dbn;
+    BeatResult minimal;
+};
