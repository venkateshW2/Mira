# ── Never commit: model weights and caches (13 GB+) ──────────────────────────
*.npz
*.pb
*.onnx
*.safetensors
*.ckpt
sa3-studio/.hf/
sa3-studio/.uvcache/
models/*
!models/README.md

# ── Virtualenvs (path-specific, rebuild with uv) ─────────────────────────────
.venv/
**/.venv/
__pycache__/
*.py[cod]

